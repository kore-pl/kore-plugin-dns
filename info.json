{
  "id": "dns",
  "name": "DNS 区域 / 记录管理插件",
  "version": "0.5.0",
  "protocol": "kore.plugin.v1",
  "lifecycle": "lazy",
  "depth_level": "basic",
  "entry": "bin/dns",
  "capabilities": [
    "system:read",
    "system:admin"
  ],
  "method_capabilities": {
    "dns.status": "system:read",
    "dns.zones": "system:read",
    "dns.records": "system:read",
    "dns.query": "system:read",
    "dns.record.add": "system:admin",
    "dns.record.update": "system:admin",
    "dns.record.delete": "system:admin",
    "dns.addRecord": "system:admin",
    "dns.updateRecord": "system:admin",
    "dns.deleteRecord": "system:admin",
    "dns.reload": "system:admin"
  },
  "triggers": [],
  "requires_kore": ">=0.1.0 <0.2.0",
  "resources": {
    "memory_mb": 6,
    "cpu_quota": "20%",
    "pids_max": 32
  },
  "depends_on": [],
  "conflicts": [],
  "scenario_tags": [
    "ops",
    "web"
  ],
  "size_bytes": 2966774,
  "requires_root": true,
  "root_actions": [
    {
      "id": "resolved-flush-caches",
      "argv": [
        "/usr/bin/resolvectl",
        "flush-caches"
      ],
      "timeout_s": 15,
      "irreversible": false,
      "description": "刷新 systemd-resolved 缓存（dns.reload 在 systemd-resolved 引擎下经内核提权通道执行；固定 argv，不改 /etc/resolv.conf，不写任何文件）"
    }
  ]
}
